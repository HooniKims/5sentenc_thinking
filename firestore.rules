rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    match /teachers/{teacherId} {
      allow read, write: if teacher() && request.auth.uid == teacherId;
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();

      match /participants/{participantId} {
        allow read: if teacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
        allow update: if teacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow delete: if teacher();
      }

      match /helpRequests/{requestId} {
        allow read: if teacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
        allow update, delete: if teacher();
      }

      match /cheers/{cheerId} {
        allow read: if teacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create, update, delete: if teacher();
      }
    }
  }
}
